# Keep /api when the frontend host proxies API requests. For a separate API host, use its full URL ending in /api.
VITE_API_URL=/api

# Portfolio Contact Configuration Points (Owner Input)
# 1. Your Fiverr Profile / Direct Gig Order Link (e.g. https://www.fiverr.com/yourusername)
VITE_FIVERR_PROFILE_URL=https://www.fiverr.com/

# 2. Your Direct Monitored Business Email (e.g. contact@yourdomain.com)
VITE_CONTACT_EMAIL=

# 3. Optional: international WhatsApp number with country code, digits only. (e.g. 919876543210)
VITE_BUSINESS_WHATSAPP=
