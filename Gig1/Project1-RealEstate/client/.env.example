# Keep /api when the frontend host proxies API requests. For a separate API host, use its full URL ending in /api.
VITE_API_URL=/api

# Portfolio Contact Configuration
# Fiverr profile / direct Gig order link
VITE_FIVERR_PROFILE_URL=https://www.fiverr.com/sellers/frameforgehq/

# 2. Your Direct Monitored Business Email (e.g. contact@yourdomain.com)
VITE_CONTACT_EMAIL=

